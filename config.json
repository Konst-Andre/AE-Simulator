{
  "_": "Налаштування тренажера. Міняти тут — не в коді. Після правки: node ae_validate.js",
  "shiftSize": 5,
  "rule": "vtm",
  "_rule": "vtm = ідеал по власній марці (поле bv у сценарії). stm = поле bm.",
  "curatorCode": "anc-2026",
  "model": {
    "endpoint": "/api/chat",
    "_endpoint": "шлях до Cloudflare Worker (крок 3). Поки Worker немає — застосунок бере ключ, введений у налаштуваннях, і йде на directEndpoint.",
    "directEndpoint": "https://api.groq.com/openai/v1/chat/completions",
    "_directEndpoint": "прямий виклик Groq. Використовується ЛИШЕ доки ключ лежить у браузері. Після кроку 3 — не використовується.",
    "name": "qwen/qwen3.8-27b",
    "reasoning_effort": "none",
    "_reasoning_effort": "none = швидкий режим розмови. Не міняти: клієнт біля каси не має думати 10 секунд.",
    "reasoning_format": "hidden",
    "temperature": 0.7,
    "top_p": 0.8,
    "presence_penalty": 0.3,
    "_presence_penalty": "Groq радить 1.5, але в нас строгий JSON із повторюваними ключами. 0.3 — стартове значення, перевірити обидва на живому прогоні.",
    "max_completion_tokens": 700,
    "_unsupported": "top_k і min_p є в рекомендаціях Qwen, але їх немає в OpenAI-сумісному API. Перевірити фактом, не додавати наосліп."
  },
  "schemas": {
    "turn": {
      "name": "client_turn",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string",
            "description": "репліка клієнта, 1-3 речення українською"
          },
          "cart": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "повний список кодів у чеку"
          },
          "ended": {
            "type": "boolean"
          },
          "endReason": {
            "type": "string",
            "enum": [
              "",
              "paid",
              "left"
            ]
          },
          "feedback": {
            "type": "string",
            "description": "порожньо доки ended=false"
          }
        },
        "required": [
          "reply",
          "cart",
          "ended",
          "endReason",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "debrief": {
      "name": "shift_debrief",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "overall": {
            "type": "string"
          },
          "mistakes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "curator": {
            "type": "string"
          }
        },
        "required": [
          "overall",
          "mistakes",
          "strengths",
          "rules",
          "curator"
        ],
        "additionalProperties": false
      }
    }
  }
}